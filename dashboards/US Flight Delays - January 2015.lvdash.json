    {
      "name": "ba9f88f6",
      "displayName": "Sankey Dataset",
      "queryLines": [
        "SELECT AIRLINE_NAME,\r\n",
        "    CASE\r\n",
        "        WHEN IS_DELAYED = 1 THEN 'Delayed'\r\n",
        "        WHEN IS_DELAYED = 0 THEN 'Not Delayed'\r\n",
        "        ELSE 'Unknown'\r\n",
        "    END AS DELAY_STATUS,\r\n",
        "    COUNT(*) AS FLIGHT_COUNT\r\n",
        "    FROM flight_delay.gold_flights\r\n",
        "    GROUP BY AIRLINE_NAME, DELAY_STATUS\r\n",
        "ORDER BY FLIGHT_COUNT DESC;"
      ],
      "catalog": "workspace",
      "schema": "default"
    },
